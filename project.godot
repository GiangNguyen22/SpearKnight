config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="SpearKnight: Dungeon Quest"
config/description="SpearKnight: Dungeon Quest - Game 2D Action Platformer nhập vai Hiệp sĩ khám phá hầm ngục hắc am."
config/version="1.0"
config/tags=PackedStringArray("2d", "framework", "platformer", "starterkit")
run/main_scene="uid://b6tvaxw54wsq0"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/stretch_mode=4
boot_splash/image="res://Assets/Splash/splash.png"
config/icon="res://Assets/Splash/splash.png"
boot_splash/minimum_display_time=500

[audio]

buses/default_bus_layout="uid://dly2dgklf0sh1"

[autoload]

GameManager="*res://Scenes/Managers/game_manager.gd"
SceneTransition="*res://Scenes/Managers/scene_transition.tscn"
AudioManager="*res://Scenes/Managers/audio_manager.tscn"
DialogueManager="*res://Scenes/UI/dialogue_box.tscn"

[display]

window/size/mode=1
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="2D-Platformer-Starter"

[editor_plugins]

enabled=PackedStringArray()

[global_group]

